{
  "version": 1,
  "requireProbeFor": [
    "wg/widgets/",
    "wg/ui/",
    "wg/scene/",
    "wg/render/",
    "wg/raster/",
    "wg/composite/",
    "wg/frame/",
    "wg/host/"
  ],
  "probes": [
    {
      "id": "drawer-default-width",
      "covers": [
        "wg/widgets/feedback.go"
      ],
      "command": [
        "go",
        "test",
        "-tags",
        "gateprobe",
        "./wg/internal/gate/probes",
        "-run",
        "^TestProbeDrawerDefaultWidth$",
        "-count=1"
      ],
      "timeout": 120000000000
    }
  ]
}
