{
  "version": 1,
  "requireProbeFor": [
    "wg/widgets/",
    "wg/ui/",
    "wg/scene/",
    "wg/render/",
    "wg/raster/",
    "wg/composite/",
    "wg/frame/",
    "wg/host/"
  ],
  "probes": [
    {
      "id": "drawer-default-width",
      "covers": [
        "wg/widgets/feedback.go"
      ],
      "command": [
        "go",
        "test",
        "-tags",
        "gateprobe",
        "./wg/internal/gate/probes",
        "-run",
        "^TestProbeDrawerDefaultWidth$",
        "-count=1"
      ],
      "timeout": 120000000000
    },
    {
      "id": "font-size-align",
      "covers": [
        "wg/widgets/table.go",
        "wg/widgets/display.go",
        "wg/widgets/descriptions.go",
        "wg/widgets/select.go",
        "wg/widgets/tree.go",
        "wg/widgets/statistic.go",
        "wg/widgets/feedback.go",
        "wg/widgets/upload.go",
        "wg/widgets/autocomplete.go",
        "wg/widgets/timepicker.go",
        "wg/widgets/calendar.go",
        "wg/widgets/transfer.go",
        "wg/widgets/tour.go",
        "wg/widgets/datepicker.go",
        "wg/ui/style.go",
        "wg/widgets/countdown.go",
        "wg/widgets/image.go",
        "wg/widgets/progress.go",
        "wg/widgets/control.go"
      ],
      "command": [
        "go",
        "test",
        "-tags",
        "gateprobe",
        "./wg/internal/gate/probes",
        "-run",
        "^TestProbeFontSizeAlign$",
        "-count=1"
      ],
      "timeout": 120000000000
    },
    {
      "id": "gate-task-reopen",
      "covers": [
        "wg/internal/gate/task.go",
        "wg/cmd/wg-gate/taskcmd.go"
      ],
      "command": [
        "go",
        "test",
        "./wg/internal/gate",
        "-run",
        "^TestReopenTask$",
        "-count=1"
      ],
      "timeout": 120000000000
    },
    {
      "id": "datepicker-showtime",
      "covers": [
        "wg/widgets/datepicker.go"
      ],
      "command": [
        "go",
        "test",
        "-tags",
        "gateprobe",
        "./wg/internal/gate/probes",
        "-run",
        "^TestProbeDatePicker(ShowTime|RangeShowTime)$",
        "-count=1"
      ],
      "timeout": 120000000000
    },
    {
      "id": "timepicker-disabledtime",
      "covers": [
        "wg/widgets/timepicker.go"
      ],
      "command": [
        "go",
        "test",
        "-tags",
        "gateprobe",
        "./wg/internal/gate/probes",
        "-run",
        "^TestProbeTimePicker(DisabledTime|FormatColumns)$",
        "-count=1"
      ],
      "timeout": 120000000000
    },
    {
      "id": "timepicker-rangepicker",
      "covers": [
        "wg/widgets/timerange.go",
        "wg/widgets/timepicker.go"
      ],
      "command": [
        "go",
        "test",
        "-tags",
        "gateprobe",
        "./wg/internal/gate/probes",
        "-run",
        "^TestProbeTimeRangePicker$",
        "-count=1"
      ],
      "timeout": 120000000000
    },
    {
      "id": "inputnumber-precision",
      "covers": [
        "wg/widgets/inputnumber.go"
      ],
      "command": [
        "go",
        "test",
        "-tags",
        "gateprobe",
        "./wg/internal/gate/probes",
        "-run",
        "^TestProbeInputNumberPrecision$",
        "-count=1"
      ],
      "timeout": 120000000000
    }
  ]
}
