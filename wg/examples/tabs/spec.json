{
  "id": "tabs",
  "structure": {
    "apiRows": 8,
    "sections": [
      "三页切换",
      "card 卡片型",
      "closable 可关闭"
    ]
  },
  "sections": [
    {
      "name": "三页切换",
      "cases": [
        {
          "name": "选中页签文字为主色",
          "target": {
            "label": "tab",
            "text": "第一页"
          },
          "then": [
            {
              "kind": "colorRatio",
              "frac": [
                0.15,
                0.15,
                0.7,
                0.7
              ],
              "expect": {
                "token": "Primary"
              },
              "minRatio": 0.05,
              "tol": 24
            }
          ]
        },
        {
          "name": "选中页签带主色下划线指示",
          "target": {
            "label": "tab",
            "text": "第一页"
          },
          "then": [
            {
              "kind": "colorRatio",
              "frac": [
                0.25,
                0.75,
                0.5,
                0.25
              ],
              "expect": {
                "token": "Primary"
              },
              "minRatio": 0.1,
              "tol": 24
            }
          ]
        },
        {
          "name": "未选中页签文字为普通文字色",
          "target": {
            "label": "tab",
            "text": "第三页"
          },
          "then": [
            {
              "kind": "colorRatio",
              "frac": [
                0.15,
                0.15,
                0.7,
                0.7
              ],
              "expect": {
                "token": "Text"
              },
              "minRatio": 0.05,
              "tol": 24
            }
          ]
        },
        {
          "name": "初始显示第一页内容",
          "target": {
            "label": "label",
            "text": "第一页内容"
          },
          "then": [
            {
              "kind": "text",
              "text": "第一页内容"
            }
          ]
        },
        {
          "name": "未选页签无其内容文字",
          "target": {
            "label": "label",
            "text": "第二页内容"
          },
          "then": [
            {
              "kind": "text",
              "text": "第二页内容",
              "notContains": true
            }
          ]
        },
        {
          "name": "点击未选中页签切换",
          "target": {
            "label": "tab",
            "text": "第二页"
          },
          "then": [
            {
              "kind": "template",
              "template": "segment-select"
            }
          ]
        }
      ]
    },
    {
      "name": "card 卡片型",
      "cases": [
        {
          "name": "card 页签为灰底（SurfaceActive）",
          "target": {
            "label": "tab",
            "text": "设置"
          },
          "then": [
            {
              "kind": "colorRatio",
              "frac": [
                0.3,
                0.3,
                0.4,
                0.4
              ],
              "expect": {
                "token": "SurfaceActive"
              },
              "minRatio": 0.3,
              "tol": 14
            }
          ]
        },
        {
          "name": "选中 card 页签为白底（Surface）",
          "target": {
            "label": "tab",
            "text": "文档"
          },
          "then": [
            {
              "kind": "colorRatio",
              "frac": [
                0.3,
                0.5,
                0.4,
                0.3
              ],
              "expect": {
                "token": "Surface"
              },
              "minRatio": 0.4,
              "tol": 14
            }
          ]
        },
        {
          "name": "card 页签有描边（Border）",
          "target": {
            "label": "tab",
            "text": "关于"
          },
          "then": [
            {
              "kind": "borderColor",
              "expect": {
                "token": "Border"
              },
              "tol": 24
            }
          ]
        },
        {
          "name": "点击 card 页签切换内容",
          "target": {
            "label": "tab",
            "text": "设置"
          },
          "when": [
            {
              "click": {}
            },
            {
              "wait": 300
            }
          ],
          "then": [
            {
              "kind": "text",
              "text": "设置内容",
              "target": {
                "label": "label",
                "text": "设置内容"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "closable 可关闭",
      "cases": [
        {
          "name": "× 热区存在（tab-close 锚）",
          "target": {
            "label": "tab-close"
          },
          "then": [
            {
              "kind": "exists",
              "count": 2
            }
          ]
        },
        {
          "name": "点击标签一的 × 移除（tab 计数 3→2）",
          "target": {
            "label": "tab",
            "text": "标签一"
          },
          "when": [
            {
              "click": {
                "target": {
                  "label": "tab",
                  "text": "标签一"
                },
                "frac": [
                  0.92,
                  0.5
                ]
              }
            },
            {
              "wait": 300
            }
          ],
          "then": [
            {
              "kind": "absent",
              "target": {
                "label": "tab",
                "text": "标签一"
              }
            },
            {
              "kind": "exists",
              "target": {
                "label": "tab",
                "text": "标签二"
              }
            }
          ]
        },
        {
          "name": "再点标签二的 × 移除（仅剩固定页）",
          "target": {
            "label": "tab",
            "text": "标签二"
          },
          "when": [
            {
              "click": {
                "target": {
                  "label": "tab",
                  "text": "标签二"
                },
                "frac": [
                  0.92,
                  0.5
                ]
              }
            },
            {
              "wait": 300
            }
          ],
          "then": [
            {
              "kind": "exists",
              "target": {
                "label": "tab",
                "text": "固定页"
              }
            }
          ]
        },
        {
          "name": "固定页（无 Closable）仍可切换选中",
          "target": {
            "label": "tab",
            "text": "固定页"
          },
          "when": [
            {
              "click": {
                "target": {
                  "label": "tab",
                  "text": "固定页"
                }
              }
            },
            {
              "wait": 300
            }
          ],
          "then": [
            {
              "kind": "text",
              "text": "固定页内容",
              "target": {
                "label": "label",
                "text": "固定页内容"
              }
            }
          ]
        }
      ]
    }
  ]
}
