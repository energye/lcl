            "label": "tree-node",
            "text": "src"
          },
          "then": [
            {
              "kind": "colorRatio",
              "frac": [
                0.05,
                0.3,
                0.6,
                0.4
              ],
              "expect": {
                "token": "Selection"
              },
              "minRatio": 0.4,
              "tol": 24
