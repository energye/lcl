{
  "id": "tree",
  "structure": {
    "apiRows": 8,
    "sections": [
      "目录树",
      "checkable 复选"
    ]
  },
  "sections": [
    {
      "name": "目录树",
      "cases": [
        {
          "name": "展开 src 出现 render 子节点",
          "target": {
            "label": "tree-node",
            "text": "src"
          },
          "when": [
            {
              "click": {}
            }
          ],
          "then": [
            {
              "kind": "exists",
              "target": {
                "label": "tree-node",
                "text": "render"
              }
            }
          ]
        },
        {
          "name": "选中行底色为 Selection、文字转 Primary",
          "target": {
            "label": "tree-node",
            "text": "src"
          },
          "then": [
            {
              "kind": "colorRatio",
              "frac": [
                0.05,
                0.3,
                0.6,
                0.4
              ],
              "expect": {
                "token": "Selection"
              },
              "minRatio": 0.4,
              "tol": 24
            },
            {
              "kind": "colorRatio",
              "frac": [
                0.05,
                0.3,
                0.3,
                0.4
              ],
              "expect": {
                "token": "Primary"
              },
              "minRatio": 0.01,
              "tol": 24
            }
          ],
          "when": [
            {
              "wait": 400
            }
          ]
        },
        {
          "name": "再次点击收起 render 消失",
          "target": {
            "label": "tree-node",
            "text": "src"
          },
          "when": [
            {
              "click": {}
            }
          ],
          "then": [
            {
              "kind": "absent",
              "target": {
                "label": "tree-node",
                "text": "render"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "checkable 复选",
      "cases": [
        {
          "name": "初始 doc 节点复选框为勾选（主色底）",
          "target": {
            "label": "checkbox-box",
            "index": 0
          },
          "then": [
            {
              "kind": "colorRatio",
              "frac": [
                0.25,
                0.25,
                0.5,
                0.5
              ],
              "expect": {
                "token": "Primary"
              },
              "minRatio": 0.4,
              "tol": 14
            }
          ]
        },
        {
          "name": "点击复选框取消勾选（回灰边白底）",
          "target": {
            "label": "checkbox",
            "index": 0
          },
          "when": [
            {
              "click": {}
            }
          ],
          "then": [
            {
              "kind": "colorRatio",
              "frac": [
                0.25,
                0.25,
                0.5,
                0.5
              ],
              "expect": {
                "token": "Surface"
              },
              "minRatio": 0.5,
              "tol": 14,
              "target": {
                "label": "checkbox-box",
                "index": 0
              }
            }
          ]
        }
      ]
    }
  ]
}
