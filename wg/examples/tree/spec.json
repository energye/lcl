            {
              "kind": "colorRatio",
              "frac": [
                0.05,
                0.3,
                0.3,
                0.4
              ],
              "expect": {
                "token": "Primary"
              },
              "minRatio": 0.01,
              "tol": 24
            }
          ],
          "when": [
            {
              "wait": 400
            }
          ]
        },
        {
          "name": "再次点击收起 render 消失",
          "target": {
            "label": "tree-node",
            "text": "src"
