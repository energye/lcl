{
  "id": "input",
  "structure": {
    "sections": [
      "受控输入与 IME",
      "三种 variant",
      "status 与尺寸",
      "前后缀与清除",
      "addon 与 count",
      "文本编辑按键"
    ],
    "apiRows": 13,
    "minElements": 10
  },
  "sections": [
    {
      "name": "受控输入与 IME",
      "cases": [
        {
          "name": "点击聚焦并可键入文本",
          "target": {
            "label": "input",
            "index": 0
          },
          "then": [
            {
              "kind": "template",
              "template": "input-type"
            }
          ]
        }
      ]
    },
    {
      "name": "三种 variant",
      "cases": [
        {
          "name": "filled 输入框点击聚焦",
          "target": {
            "label": "input",
            "index": 2
          },
          "when": [],
          "then": [
            {
              "kind": "template",
              "template": "input-focus"
            }
          ]
        },
        {
          "name": "variant 三档纵向依次排列",
          "target": {
            "label": "input",
            "index": 3
          },
          "then": [
            {
              "kind": "geometry",
              "below": {
                "label": "input",
                "index": 2
              }
            },
            {
              "kind": "geometry",
              "widthAtLeast": 200
            }
          ]
        },
        {
          "name": "outlined 默认边框为 colorBorder 1px",
          "target": {
            "label": "input",
            "text": "outlined"
          },
          "then": [
            {
              "kind": "borderWidth",
              "expectWidth": 1,
              "tol": 1
            },
            {
              "kind": "borderColor",
              "expect": {
                "token": "Border"
              },
              "tol": 24
            }
          ]
        },
        {
          "name": "outlined hover 边框转 colorPrimaryHover",
          "target": {
            "label": "input",
            "text": "outlined"
          },
          "when": [
            {
              "hover": {}
            },
            {
              "wait": 200
            }
          ],
          "then": [
            {
              "kind": "borderColor",
              "expect": {
                "token": "PrimaryHover"
              },
              "tol": 24
            }
          ]
        },
        {
          "name": "outlined 聚焦边框转 colorPrimary",
          "target": {
            "label": "input",
            "text": "outlined"
          },
          "when": [
            {
              "click": {}
            },
            {
              "wait": 250
            }
          ],
          "then": [
            {
              "kind": "borderColor",
              "expect": {
                "token": "Primary"
              },
              "tol": 24
            }
          ]
        },
        {
          "name": "占位文本色为 colorTextPlaceholder #BFBFBF",
          "target": {
            "label": "input",
            "text": "outlined"
          },
          "then": [
            {
              "kind": "colorRatio",
              "frac": [
                0.06,
                0.25,
                0.5,
                0.5
              ],
              "expect": {
                "hex": "#BFBFBF",
                "note": "colorTextPlaceholder"
              },
              "minRatio": 0.02,
              "tol": 24
            }
          ]
        },
        {
          "name": "filled 聚焦底色转白（colorBgContainer）",
          "target": {
            "label": "input",
            "text": "filled"
          },
          "when": [
            {
              "click": {}
            },
            {
              "wait": 250
            }
          ],
          "then": [
            {
              "kind": "colorRatio",
              "frac": [
                0.15,
                0.35,
                0.5,
                0.3
              ],
              "expect": {
                "token": "Surface"
              },
              "minRatio": 0.8,
              "tol": 8
            }
          ]
        },
        {
          "name": "borderless 无边框",
          "target": {
            "label": "input",
            "text": "borderless"
          },
          "then": [
            {
              "kind": "borderWidth",
              "expectWidth": 0,
              "tol": 1
            }
          ]
        }
      ]
    },
    {
