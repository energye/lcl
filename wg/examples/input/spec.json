        {
          "name": "禁用底色为 colorBgContainerDisabled",
          "target": {
            "label": "input",
            "text": "禁用状态"
          },
          "then": [
            {
              "kind": "colorRatio",
              "frac": [
                0.15,
                0.35,
                0.5,
                0.3
              ],
              "expect": {
                "hex": "#F5F5F5",
                "note": "colorBgContainerDisabled"
              },
              "minRatio": 0.8,
              "tol": 8
            }
          ]
        },
        {
          "name": "禁用文字与边框仍为禁用专色",
          "target": {
            "label": "input",
            "text": "禁用状态"
          },
          "then": [
            {
              "kind": "colorRatio",
              "frac": [
                0.06,
                0.25,
                0.5,
                0.5
              ],
              "expect": {
                "token": "BorderStrong"
              },
              "minRatio": 0.02,
              "tol": 24
            },
            {
              "kind": "borderColor",
              "expect": {
                "token": "Border"
              },
              "tol": 24
            }
          ]
        }
      ]
    },
