{
  "id": "divider",
  "structure": {
    "apiRows": 5,
    "sections": [
      "水平分隔线",
      "带文字分隔线"
    ]
  },
  "sections": [
    {
      "name": "水平分隔线",
      "cases": [
        {
          "name": "两条分隔线存在",
          "target": {
            "label": "divider"
          },
          "then": [
            {
              "kind": "exists",
              "count": 2
            }
          ]
        },
        {
          "name": "分隔线为细线（1-3px）",
          "target": {
            "label": "divider",
            "index": 0
          },
          "then": [
            {
              "kind": "geometry",
              "heightBetween": [
                0.5,
                4
              ]
            }
          ]
        },
        {
          "name": "分隔线颜色为描边色",
          "target": {
            "label": "divider",
            "index": 0
          },
          "then": [
            {
              "kind": "color",
              "expect": {
                "token": "Border"
              },
              "tol": 30
            }
          ]
        }
      ]
    },
    {
      "name": "带文字分隔线",
      "cases": [
        {
          "name": "带文字分隔线显式宽 400",
          "target": {
            "label": "divider",
            "index": 2
          },
          "then": [
            {
              "kind": "geometry",
              "widthBetween": [
                400,
                400
              ]
            }
          ]
        },
        {
          "name": "文字为 TextMuted",
          "target": {
            "label": "divider",
            "index": 2
          },
          "then": [
            {
              "kind": "colorRatio",
              "frac": [
                0.4,
                0.15,
                0.2,
                0.7
              ],
              "expect": {
                "token": "TextMuted"
              },
              "minRatio": 0.02,
              "tol": 24
            }
          ]
        }
      ]
    }
  ]
}
