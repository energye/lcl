      "name": "打开模态",
      "cases": [
        {
          "name": "点击打开模态（BandModal）",
          "target": {
            "label": "button",
            "text": "打开模态框"
          },
          "when": [
            {
              "click": {}
            }
          ],
          "then": [
            {
              "kind": "overlay",
              "count": 1,
              "band": "modal"
            }
          ]
        },
        {
          "name": "点确定按钮关闭模态",
          "target": {
            "label": "button",
            "text": "打开模态框"
          },
          "when": [
            {
              "click": {}
            },
            {
              "wait": 300
            },
            {
              "click": {
                "target": {
                  "label": "button",
                  "text": "确定"
                }
              }
            },
            {
              "wait": 300
            }
          ],
          "then": [
            {
              "kind": "overlay",
              "count": 0,
              "band": "modal"
            }
          ]
        },
        {
          "name": "点取消按钮关闭模态",
          "target": {
            "label": "button",
            "text": "打开模态框"
          },
          "when": [
            {
              "click": {}
            },
            {
              "wait": 300
            },
            {
              "click": {
                "target": {
                  "label": "button",
                  "text": "取消"
                }
              }
            },
            {
              "wait": 300
            }
          ],
          "then": [
            {
              "kind": "overlay",
              "count": 0,
              "band": "modal"
            }
          ]
        },
        {
          "name": "打开后 Esc 关闭",
          "target": {
            "label": "button",
            "text": "打开模态框"
          },
          "when": [
            {
              "click": {}
            },
            {
              "key": "escape"
            }
          ],
          "then": [
            {
              "kind": "overlay",
              "count": 0,
              "band": "modal"
            }
          ]
        }
      ]
    },
