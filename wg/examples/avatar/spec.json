{
  "id": "avatar",
  "structure": {
    "apiRows": 6,
    "sections": [
      "三档尺寸",
      "图标头像",
      "头像组"
    ]
  },
  "sections": [
    {
      "name": "三档尺寸",
      "cases": [
        {
          "name": "三档头像存在",
          "target": {
            "label": "avatar"
          },
          "then": [
            {
              "kind": "exists",
              "count": 3
            }
          ]
        },
        {
          "name": "36 档尺寸直径 36",
          "target": {
            "label": "avatar",
            "index": 1
          },
          "then": [
            {
              "kind": "geometry",
              "widthBetween": [
                36,
                36
              ]
            }
          ]
        },
        {
          "name": "默认头像为灰底（colorFillTertiary）",
          "target": {
            "label": "avatar",
            "index": 0
          },
          "then": [
            {
              "kind": "colorRatio",
              "frac": [
                0.25,
                0.15,
                0.5,
                0.2
              ],
              "expect": {
                "token": "SurfaceActive"
              },
              "minRatio": 0.5,
              "tol": 14
            }
          ]
        },
        {
          "name": "默认头像文字为深色（colorText）",
          "target": {
            "label": "avatar",
            "index": 0
          },
          "then": [
            {
              "kind": "colorRatio",
              "frac": [
                0.3,
                0.3,
                0.4,
                0.4
              ],
              "expect": {
                "token": "Text"
              },
              "minRatio": 0.05,
              "tol": 24
            }
          ]
        },
        {
          "name": "48 档尺寸直径 48",
          "target": {
            "label": "avatar",
            "index": 2
          },
          "then": [
            {
              "kind": "geometry",
              "widthBetween": [
                48,
                48
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "图标头像",
      "cases": [
        {
          "name": "灰底 user 图标头像存在",
          "target": {
            "label": "avatar",
            "index": 0
          },
          "then": [
            {
              "kind": "exists"
            }
          ]
        },
        {
          "name": "主色底头像文字为白（OnPrimary）",
          "target": {
            "label": "avatar",
            "index": 1
          },
          "then": [
            {
              "kind": "colorRatio",
              "frac": [
                0.4,
                0.35,
                0.3,
                0.3
              ],
              "expect": {
                "token": "OnPrimary"
              },
              "minRatio": 0.05,
              "tol": 24
            }
          ]
        }
      ]
    },
    {
      "name": "头像组",
      "cases": [
        {
          "name": "尾项文本为 +2（唯一文本锚）",
          "target": {
            "label": "avatar",
            "text": "+"
          },
          "then": [
            {
              "kind": "text",
              "text": "+2"
            }
          ]
        },
        {
          "name": "组内第 3 成员（Max 内最后一位）显示首字",
          "target": {
            "label": "avatar",
            "text": "王"
          },
          "then": [
            {
              "kind": "text",
              "text": "王"
            }
          ]
        },
        {
          "name": "尾项尺寸与组员一致 32",
          "target": {
            "label": "avatar",
            "text": "+"
          },
          "then": [
            {
              "kind": "geometry",
              "widthBetween": [
                30,
                34
              ]
            }
          ]
        }
      ]
    }
  ]
}
