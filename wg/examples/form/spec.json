{
  "id": "form",
  "structure": {
    "apiRows": 7,
    "sections": [
      "必填校验"
    ]
  },
  "sections": [
    {
      "name": "必填校验",
      "cases": [
        {
          "name": "空表单提交报校验失败",
          "target": {
            "label": "button",
            "index": 0
          },
          "when": [
            {
              "click": {}
            }
          ],
          "then": [
            {
              "kind": "text",
              "target": {
                "label": "button",
                "index": 0
              },
              "text": "校验失败"
            },
            {
              "kind": "borderColor",
              "target": {
                "label": "input",
                "index": 0
              },
              "expect": {
                "token": "Danger"
              },
              "tol": 24
            },
            {
              "kind": "colorRatio",
              "target": {
                "label": "form-error",
                "text": "用户名不能为空"
              },
              "frac": [
                0.1,
                0.2,
                0.8,
                0.6
              ],
              "expect": {
                "token": "Danger"
              },
              "minRatio": 0.03,
              "tol": 24
            }
          ]
        },
        {
          "name": "填入用户名后提交通过",
          "target": {
            "label": "input",
            "index": 0
          },
          "when": [
            {
              "click": {
                "target": {
                  "label": "input",
                  "index": 0
                }
              }
            },
            {
              "typeText": "wg"
            },
            {
              "click": {
                "target": {
                  "label": "button",
                  "index": 0
                }
              }
            }
          ],
          "then": [
            {
              "kind": "text",
              "target": {
                "label": "button",
                "index": 0
              },
              "text": "校验通过"
            },
            {
              "kind": "borderColor",
              "target": {
                "label": "input",
                "index": 0
              },
              "expect": {
                "token": "Border"
              },
              "tol": 24
            }
          ]
        }
      ]
    }
  ]
}
