          },
          "when": [
            {
              "click": {}
            },
            {
              "wait": 300
            }
          ],
          "then": [
            {
              "kind": "overlay",
              "count": 1
            },
            {
              "kind": "exists",
              "target": {
                "label": "image-preview"
              }
            },
            {
              "kind": "exists",
              "target": {
                "label": "image-close"
              }
            }
          ]
        },
        {
          "name": "点关闭钮退出预览",
          "target": {
            "label": "image",
            "index": 0
          },
          "when": [
            {
              "click": {}
            },
            {
              "wait": 300
            },
            {
              "click": {
                "target": {
                  "label": "image-close"
                }
              }
            },
            {
              "wait": 300
            }
          ],
          "then": [
            {
              "kind": "overlay",
              "count": 0
            }
          ]
        },
        {
          "name": "Esc 退出预览",
          "target": {
            "label": "image",
            "index": 0
          },
          "when": [
            {
              "click": {}
            },
            {
              "wait": 300
            },
            {
              "key": "escape"
            },
            {
              "wait": 300
            }
          ],
          "then": [
            {
              "kind": "overlay",
              "count": 0
            }
          ]
        },
        {
