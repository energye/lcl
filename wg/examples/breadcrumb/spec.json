{
  "id": "breadcrumb",
  "structure": {
    "apiRows": 4,
    "sections": [
      "三级路径",
      "下拉菜单"
    ]
  },
  "sections": [
    {
      "name": "三级路径",
      "cases": [
        {
          "name": "末项为当前页深色文字",
          "target": {
            "label": "breadcrumb-item",
            "text": "渲染引擎"
          },
          "then": [
            {
              "kind": "colorRatio",
              "frac": [
                0.1,
                0.2,
                0.8,
                0.6
              ],
              "expect": {
                "token": "Text"
              },
              "minRatio": 0.05,
              "tol": 24
            }
          ]
        },
        {
          "name": "可点项为 TextMuted 次级色",
          "target": {
            "label": "breadcrumb",
            "text": "资源管理"
          },
          "then": [
            {
              "kind": "colorRatio",
              "frac": [
                0.1,
                0.2,
                0.8,
                0.6
              ],
              "expect": {
                "token": "TextMuted"
              },
              "minRatio": 0.05,
              "tol": 24
            }
          ]
        },
        {
          "name": "点击非末项回调回显",
          "target": {
            "label": "button",
            "index": 0
          },
          "when": [
            {
              "click": {
                "target": {
                  "label": "breadcrumb",
                  "text": "首页"
                }
              }
            },
            {
              "wait": 250
            }
          ],
          "then": [
            {
              "kind": "text",
              "text": "点击了：首页"
            }
          ]
        }
      ]
    },
    {
      "name": "下拉菜单",
      "cases": [
        {
          "name": "点击带菜单项弹出下拉面板（子项可见）",
          "target": {
            "label": "breadcrumb",
            "text": "控制台"
          },
          "when": [
            {
              "click": {
                "target": {
                  "label": "breadcrumb",
                  "text": "控制台"
                }
              }
            },
            {
              "wait": 300
            }
          ],
          "then": [
            {
              "kind": "overlay",
              "count": 1
            },
            {
              "kind": "exists",
              "target": {
                "label": "breadcrumb-menu-item",
                "text": "General"
              }
            },
            {
              "kind": "exists",
              "target": {
                "label": "breadcrumb-menu-item",
                "text": "Navigation"
              }
            }
          ]
        },
        {
          "name": "子项 down 即执行回调回显且面板关",
          "target": {
            "label": "breadcrumb",
            "text": "控制台"
          },
          "when": [
            {
              "click": {
                "target": {
                  "label": "breadcrumb",
                  "text": "控制台"
                }
              }
            },
            {
              "wait": 300
            },
            {
              "click": {
                "target": {
                  "label": "breadcrumb-menu-item",
                  "text": "Layout"
                }
              }
            },
            {
              "wait": 300
            }
          ],
          "then": [
            {
              "kind": "overlay",
              "count": 0
            },
            {
              "kind": "text",
              "text": "菜单：控制台 / Layout",
              "target": {
                "label": "button",
                "index": 1
              }
            }
          ]
        },
        {
          "name": "Esc 关闭下拉面板",
          "target": {
            "label": "breadcrumb",
            "text": "控制台"
          },
          "when": [
            {
              "click": {
                "target": {
                  "label": "breadcrumb",
                  "text": "控制台"
                }
              }
            },
            {
              "wait": 300
            },
            {
              "key": "escape"
            },
            {
              "wait": 300
            }
          ],
          "then": [
            {
              "kind": "overlay",
              "count": 0
            }
          ]
        },
        {
          "name": "无菜单项点击仍走 OnClick（应用中心回显）",
          "target": {
            "label": "breadcrumb",
            "text": "应用中心"
          },
          "when": [
            {
              "click": {
                "target": {
                  "label": "breadcrumb",
                  "text": "应用中心"
                }
              }
            },
            {
              "wait": 300
            }
          ],
          "then": [
            {
              "kind": "overlay",
              "count": 0
            },
            {
              "kind": "text",
              "text": "点击了：应用中心",
              "target": {
                "label": "button",
                "index": 1
              }
            }
          ]
        }
      ]
    }
  ]
}
