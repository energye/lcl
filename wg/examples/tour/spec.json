{
  "id": "tour",
  "structure": {
    "apiRows": 5,
    "sections": [
      "三步引导"
    ]
  },
  "sections": [
    {
      "name": "三步引导",
      "cases": [
        {
          "name": "点开始引导弹第一步卡",
          "target": {
            "label": "tour-open"
          },
          "when": [
            {
              "click": {}
            },
            {
              "wait": 300
            }
          ],
          "then": [
            {
              "kind": "overlay",
              "count": 1
            },
            {
              "kind": "text",
              "text": "欢迎",
              "target": {
                "label": "tour-title"
              }
            },
            {
              "kind": "text",
              "text": "1 / 3",
              "target": {
                "label": "tour-indicator"
              }
            }
          ]
        },
        {
          "name": "下一步切第二步",
          "target": {
            "label": "tour-open"
          },
          "when": [
            {
              "click": {}
            },
            {
              "wait": 300
            },
            {
              "click": {
                "target": {
                  "label": "tour-next"
                }
              }
            },
            {
              "wait": 400
            }
          ],
          "then": [
            {
              "kind": "overlay",
              "count": 1
            },
            {
              "kind": "text",
              "text": "创建任务",
              "target": {
                "label": "tour-title"
              }
            },
            {
              "kind": "text",
              "text": "2 / 3",
              "target": {
                "label": "tour-indicator"
              }
            }
          ]
        },
        {
          "name": "第二步出现上一步",
          "target": {
            "label": "tour-open"
          },
          "when": [
            {
              "click": {}
            },
            {
              "wait": 300
            },
            {
              "click": {
                "target": {
                  "label": "tour-next"
                }
              }
            },
            {
              "wait": 400
            }
          ],
          "then": [
            {
              "kind": "exists",
              "target": {
                "label": "tour-prev"
              }
            }
          ]
        },
        {
          "name": "Esc 关闭引导",
          "target": {
            "label": "tour-open"
          },
          "when": [
            {
              "click": {}
            },
            {
              "wait": 300
            },
            {
              "key": "escape"
            },
            {
              "wait": 300
            }
          ],
          "then": [
            {
              "kind": "overlay",
              "count": 0
            }
          ]
        }
      ]
    }
  ]
}
