{
  "id": "rate",
  "structure": {
    "apiRows": 5,
    "sections": [
      "五星评分",
      "三星只读"
    ]
  },
  "sections": [
    {
      "name": "五星评分",
      "cases": [
        {
          "name": "点击第三颗星设定评分",
          "target": {
            "label": "rate-star",
            "index": 2
          },
          "then": [
            {
              "kind": "template",
              "template": "rate-set"
            }
          ]
        },
        {
          "name": "星星尺寸 20",
          "target": {
            "label": "rate-star",
            "index": 0
          },
          "then": [
            {
              "kind": "geometry",
              "widthBetween": [
                20,
                20
              ]
            }
          ]
        },
        {
          "name": "选中星为 colorWarning",
          "target": {
            "label": "rate-star",
            "index": 2
          },
          "then": [
            {
              "kind": "colorRatio",
              "frac": [
                0.3,
                0.3,
                0.4,
                0.4
              ],
              "expect": {
                "token": "Warning"
              },
              "minRatio": 0.4,
              "tol": 14
            }
          ]
        },
        {
          "name": "未选星为灰（colorFillSecondary）",
          "target": {
            "label": "rate-star",
            "index": 4
          },
          "then": [
            {
              "kind": "colorRatio",
              "frac": [
                0.3,
                0.3,
                0.4,
                0.4
              ],
              "expect": {
                "token": "SurfaceActive"
              },
              "minRatio": 0.4,
              "tol": 14
            }
          ]
        }
      ]
    },
    {
      "name": "三星只读",
      "cases": [
        {
          "name": "只读评分点击无反馈",
          "target": {
            "label": "rate-star",
            "disabled": true,
            "index": 0
          },
          "then": [
            {
              "kind": "template",
              "template": "disabled-no-op"
            }
          ]
        },
        {
          "name": "只读选中星保持 colorWarning",
          "target": {
            "label": "rate-star",
            "index": 5
          },
          "then": [
            {
              "kind": "colorRatio",
              "frac": [
                0.3,
                0.3,
                0.4,
                0.4
              ],
              "expect": {
                "token": "Warning"
              },
              "minRatio": 0.4,
              "tol": 14
            }
          ]
        }
      ]
    }
  ]
}
