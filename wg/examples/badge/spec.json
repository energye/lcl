{
  "id": "badge",
  "structure": {
    "apiRows": 5,
    "sections": [
      "三态角标",
      "status 语义色"
    ]
  },
  "sections": [
    {
      "name": "三态角标",
      "cases": [
        {
          "name": "三态角标存在",
          "target": {
            "label": "badge"
          },
          "then": [
            {
              "kind": "exists",
              "count": 3
            }
          ]
        },
        {
          "name": "计数角标为 Error 红底",
          "target": {
            "label": "badge",
            "index": 0
          },
          "then": [
            {
              "kind": "color",
              "frac": [
                0.12,
                0.15,
                0.3,
                0.7
              ],
              "expect": {
                "token": "Danger"
              },
              "tol": 20
            }
          ]
        },
        {
          "name": "文本角标文字为白（OnDanger）",
          "target": {
            "label": "badge",
            "text": "NEW"
          },
          "then": [
            {
              "kind": "colorRatio",
              "frac": [
                0.2,
                0.25,
                0.6,
                0.5
              ],
              "expect": {
                "token": "OnDanger"
              },
              "minRatio": 0.05,
              "tol": 24
            }
          ]
        },
        {
          "name": "圆点直径 8",
          "target": {
            "label": "badge",
            "index": 2
          },
          "then": [
            {
              "kind": "geometry",
              "widthBetween": [
                8,
                8
              ]
            },
            {
              "kind": "geometry",
              "heightBetween": [
                8,
                8
              ]
            }
          ]
        },
        {
          "name": "溢出显示 99+",
          "target": {
            "label": "badge",
            "text": "99+"
          },
          "then": [
            {
              "kind": "text",
              "text": "99+"
            }
          ]
        }
      ]
    },
    {
      "name": "status 语义色",
      "cases": [
        {
          "name": "Success 状态为绿底",
          "target": {
            "label": "badge",
            "text": "status",
            "index": 0
          },
          "then": [
            {
              "kind": "colorRatio",
              "frac": [
                0.2,
                0.2,
                0.6,
                0.6
              ],
              "expect": {
                "token": "Success"
              },
              "minRatio": 0.4,
              "tol": 14
            }
          ]
        },
        {
          "name": "Processing 状态为主色底",
          "target": {
            "label": "badge",
            "text": "status",
            "index": 1
          },
          "then": [
            {
              "kind": "colorRatio",
              "frac": [
                0.2,
                0.2,
                0.6,
                0.6
              ],
              "expect": {
                "token": "Primary"
              },
              "minRatio": 0.4,
              "tol": 14
            }
          ]
        },
        {
          "name": "Error 状态为红底",
          "target": {
            "label": "badge",
            "text": "status",
            "index": 2
          },
          "then": [
            {
              "kind": "colorRatio",
              "frac": [
                0.2,
                0.2,
                0.6,
                0.6
              ],
              "expect": {
                "token": "Danger"
              },
              "minRatio": 0.4,
              "tol": 14
            }
          ]
        }
