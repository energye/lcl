{
  "id": "spin",
  "structure": {
    "apiRows": 2,
    "sections": [
      "四个相位",
      "自动旋转",
      "tip 文案"
    ]
  },
  "sections": [
    {
      "name": "四个相位",
      "cases": [
        {
          "name": "相位 0 弧线为主色",
          "target": {
            "label": "spin",
            "index": 0
          },
          "then": [
            {
              "kind": "colorRatio",
              "frac": [
                0.2,
                0.2,
                0.6,
                0.6
              ],
              "expect": {
                "token": "Primary"
              },
              "minRatio": 0.008,
              "tol": 24
            }
          ]
        },
        {
          "name": "四个相位指示器直径 28",
          "target": {
            "label": "spin",
            "index": 3
          },
          "then": [
            {
              "kind": "geometry",
              "widthBetween": [
                28,
                28
              ]
            },
            {
              "kind": "geometry",
              "heightBetween": [
                28,
                28
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "自动旋转",
      "cases": [
        {
          "name": "自动旋转指示器持续转（两帧不同）",
          "target": {
            "label": "spin",
            "index": 4
          },
          "then": [
            {
              "kind": "template",
              "template": "spinner-spin",
              "text": "no-still"
            }
          ]
        }
      ]
    },
    {
      "name": "tip 文案",
      "cases": [
        {
          "name": "tip 文案存在",
          "target": {
            "label": "spin-tip",
            "text": "数据加载中"
          },
          "then": [
            {
              "kind": "exists",
              "target": {
                "label": "spin-tip",
                "text": "数据加载中"
              }
            }
          ]
        },
        {
          "name": "tip 文字为 TextMuted",
          "target": {
            "label": "spin-tip",
            "text": "数据加载中"
          },
          "then": [
            {
              "kind": "colorRatio",
              "frac": [
                0.3,
                0.6,
                0.4,
                0.3
              ],
              "expect": {
                "token": "TextMuted"
              },
              "minRatio": 0.02,
              "tol": 24
            }
          ]
        }
      ]
    }
  ]
}
