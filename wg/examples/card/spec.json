{
  "id": "card",
  "structure": {
    "apiRows": 7,
    "sections": [
      "三段式卡片",
      "actions 操作区",
      "cover 封面卡片"
    ]
  },
  "sections": [
    {
      "name": "三段式卡片",
      "cases": [
        {
          "name": "卡片背景为表面色",
          "target": {
            "label": "card",
            "index": 0
          },
          "then": [
            {
              "kind": "color",
              "frac": [
                0.1,
                0.02,
                0.8,
                0.08
              ],
              "expect": {
                "token": "Surface"
              },
              "tol": 14
            }
          ]
        },
        {
          "name": "卡片标题下有分隔线",
          "target": {
            "label": "card-divider",
            "index": 0
          },
          "then": [
            {
              "kind": "exists",
              "target": {
                "label": "card-divider",
                "index": 0
              }
            }
          ]
        },
        {
          "name": "卡片圆角为 LG（8）",
          "target": {
            "label": "card",
            "index": 0
          },
          "then": [
            {
              "kind": "geometry",
              "widthAtLeast": 200
            }
          ]
        }
      ]
    },
    {
      "name": "actions 操作区",
      "cases": [
        {
          "name": "actions 项文字存在",
          "target": {
            "label": "label",
            "text": "收藏"
          },
          "then": [
            {
              "kind": "exists",
              "target": {
                "label": "label",
                "text": "收藏"
              }
            }
          ]
        },
        {
          "name": "actions 区与内容间有分隔线",
          "target": {
            "label": "card-divider",
            "index": 1
          },
          "then": []
        }
      ]
    },
    {
      "name": "cover 封面卡片",
      "cases": [
        {
          "name": "cover 区存在（card-cover 锚）",
          "target": {
            "label": "card-cover"
          },
          "then": [
            {
              "kind": "exists"
            }
          ]
        },
        {
          "name": "cover 内图标圆为 SurfaceActive 灰（64 头像）",
          "target": {
            "label": "card-cover"
          },
          "then": [
            {
              "kind": "colorRatio",
              "frac": [
                0.35,
                0.35,
                0.3,
                0.3
              ],
              "expect": {
                "token": "SurfaceActive"
              },
              "minRatio": 0.15,
              "tol": 24
            }
          ]
        },
        {
          "name": "cover 高度为 120 通栏",
          "target": {
            "label": "card-cover"
          },
          "then": [
            {
              "kind": "geometry",
              "heightBetween": [
                118,
                122
              ]
            }
          ]
        }
      ]
    }
  ]
}
