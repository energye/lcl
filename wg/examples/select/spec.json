{
  "id": "select",
  "structure": {
    "apiRows": 12,
    "sections": [
      "label/value 分离",
      "基本单选",
      "分组 + 搜索",
      "多选",
      "多选折叠"
    ]
  },
  "sections": [
    {
      "name": "label/value 分离",
      "cases": [
        {
          "name": "初始选中 Go（Label 显示）",
          "target": {
            "label": "select",
            "text": "Go"
          },
          "then": [
            {
              "kind": "text",
              "text": "Go",
              "target": {
                "label": "select",
                "text": "Go"
              }
            }
          ]
        },
        {
          "name": "点选 Rust：触发框显示 Label、提交值变 rust",
          "target": {
            "label": "button",
            "text": "提交值："
          },
          "when": [
            {
              "click": {
                "target": {
                  "label": "select",
                  "text": "Go"
                }
              }
            },
            {
              "wait": 300
            },
            {
              "click": {
                "target": {
                  "label": "select-option",
                  "text": "Rust"
                }
              }
            },
            {
              "wait": 300
            }
          ],
          "then": [
            {
              "kind": "text",
              "text": "Rust",
              "target": {
                "label": "select",
                "text": "Rust"
              }
            },
            {
              "kind": "text",
              "text": "提交值：rust",
              "target": {
                "label": "button",
                "text": "提交值："
              }
            }
          ]
        },
        {
          "name": "再选 Go：提交值变 go",
          "target": {
            "label": "button",
            "text": "提交值："
          },
          "when": [
            {
              "click": {
                "target": {
                  "label": "select",
                  "text": "Rust"
                }
              }
            },
            {
              "wait": 300
            },
            {
              "click": {
                "target": {
                  "label": "select-option",
                  "text": "Go"
                }
              }
            },
            {
              "wait": 300
            }
          ],
          "then": [
            {
              "kind": "text",
              "text": "提交值：go",
              "target": {
                "label": "button",
                "text": "提交值："
              }
            }
          ]
        }
      ]
    },
    {
      "name": "基本单选",
      "cases": [
        {
          "name": "触发框边框 1px",
          "target": {
            "label": "select",
            "text": "请选择"
          },
          "then": [
            {
              "kind": "borderWidth",
              "expectWidth": 1,
              "tol": 1
            }
          ]
        },
        {
          "name": "未选占位文字为 colorTextPlaceholder",
          "target": {
            "label": "select",
            "text": "请选择"
          },
          "then": [
            {
              "kind": "colorRatio",
              "frac": [
                0.12,
                0.25,
                0.76,
                0.5
              ],
              "expect": {
                "token": "TextPlaceholder"
              },
              "minRatio": 0.01,
              "tol": 24
            }
          ]
        },
        {
          "name": "下拉打开、Esc 关闭、可再次打开",
          "target": {
            "label": "select",
            "text": "请选择"
          },
          "then": [
            {
              "kind": "template",
              "template": "select-open-close"
            }
          ]
        }
      ]
    },
    {
      "name": "分组 + 搜索",
      "cases": [
        {
          "name": "分组下拉打开与关闭",
          "target": {
            "label": "select",
            "index": 1
          },
          "then": [
            {
              "kind": "template",
              "template": "select-open-close"
            }
          ]
        }
      ]
    },
    {
      "name": "多选",
      "cases": [
        {
          "name": "多选下拉打开与关闭",
          "target": {
            "label": "select",
            "index": 2
          },
          "then": [
            {
              "kind": "template",
              "template": "select-open-close"
            }
          ]
        },
        {
          "name": "初值 2 tag 渲染（灰底圆角 × 可删）",
          "target": {
            "label": "select-tag",
            "index": 0
          },
          "then": [
            {
              "kind": "exists",
              "count": 2,
              "target": {
                "label": "select-tag"
              }
            },
            {
              "kind": "exists",
              "count": 2,
              "target": {
                "label": "select-tag-x"
              }
            }
          ]
        },
        {
          "name": "tag × 删除（初值渲染→删 1 剩 1）",
          "target": {
            "label": "select-tag-x",
            "index": 0
          },
          "when": [
            {
              "click": {
                "target": {
                  "label": "select-tag-x",
                  "index": 0
                }
              }
            },
            {
              "wait": 300
            }
          ],
          "then": [
            {
              "kind": "exists",
              "count": 1,
              "target": {
                "label": "select-tag"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "多选折叠",
      "cases": [
        {
          "name": "MaxTagCount=2 初值 3 个折叠 +1 chip",
          "target": {
            "label": "select-tag",
            "index": 0
          },
          "when": [
            {
              "click": {
                "target": {
                  "label": "select",
                  "index": 3
                }
              }
            },
            {
              "wait": 300
            },
            {
              "key": "escape"
            },
            {
              "wait": 300
            }
          ],
          "then": [
            {
              "kind": "exists",
              "count": 2,
              "target": {
                "label": "select-tag"
              }
            },
            {
              "kind": "exists",
              "target": {
                "label": "select-tag-more"
              }
            }
          ]
        }
      ]
    }
  ]
}
