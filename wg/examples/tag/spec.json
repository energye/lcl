    {
      "name": "closable 可关闭",
      "cases": [
        {
          "name": "× 图标存在且可点",
          "target": {
            "label": "tag-close"
          },
          "then": [
            {
              "kind": "exists"
            }
          ]
        },
        {
          "name": "点击×后 golang 标签消失",
          "target": {
            "label": "tag",
            "text": "golang"
          },
          "when": [
            {
              "wait": 300
            },
            {
              "click": {
                "target": {
                  "label": "tag",
                  "text": "golang"
                },
                "frac": [
                  0.92,
                  0.5
                ]
              }
            },
            {
              "wait": 400
            }
          ],
          "then": [
            {
              "kind": "absent",
              "target": {
                "label": "tag",
                "text": "golang"
              }
            },
            {
              "kind": "exists",
              "target": {
                "label": "tag",
                "text": "React"
              }
            }
          ]
        },
        {
          "name": "再点×后 React 标签消失",
          "target": {
            "label": "tag",
            "text": "React"
          },
          "when": [
            {
              "wait": 300
            },
            {
              "click": {
                "target": {
                  "label": "tag",
                  "text": "React"
                },
                "frac": [
                  0.92,
                  0.5
                ]
              }
            },
            {
              "wait": 400
            }
          ],
          "then": [
            {
              "kind": "absent",
              "target": {
                "label": "tag",
                "text": "React"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "checkable 可选中",
      "cases": [
        {
          "name": "三个可选中标签存在",
          "target": {
            "label": "tag",
            "text": "后端"
          },
          "then": [
            {
              "kind": "exists"
            }
          ]
        },
        {
          "name": "点击标签选中（主色实底）",
          "target": {
            "label": "tag",
            "text": "后端"
          },
          "when": [
            {
              "click": {}
            },
            {
              "wait": 300
            }
          ],
          "then": [
            {
              "kind": "colorRatio",
              "frac": [
                0.2,
                0.2,
