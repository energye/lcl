              ],
              "expect": {
                "token": "Primary"
              },
              "minRatio": 0.35,
              "tol": 14,
              "target": {
                "label": "tag",
                "text": "后端"
              }
            }
          ]
        },
        {
          "name": "再点击取消选中（恢复灰底）",
          "target": {
            "label": "tag",
            "text": "后端"
          },
          "when": [
            {
              "click": {}
            },
            {
              "wait": 300
            }
          ],
          "then": [
            {
              "kind": "colorRatio",
              "frac": [
                0.3,
                0.3,
                0.5,
                0.6
              ],
              "expect": {
                "token": "SurfaceSunken"
              },
              "minRatio": 0.4,
              "tol": 14,
