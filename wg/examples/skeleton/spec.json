{
  "id": "skeleton",
  "structure": {
    "apiRows": 7,
    "sections": [
      "四行占位",
      "呼吸态",
      "元素形态",
      "组合形态"
    ]
  },
  "sections": [
    {
      "name": "四行占位",
      "cases": [
        {
          "name": "骨架存在且宽度足够",
          "target": {
            "label": "skeleton"
          },
          "then": [
            {
              "kind": "geometry",
              "widthAtLeast": 300
            }
          ]
        }
      ]
    },
    {
      "name": "呼吸态",
      "cases": [
        {
          "name": "呼吸态画面持续变化（动态效果存在）",
          "target": {
            "label": "skeleton",
            "index": 1
          },
          "then": [
            {
              "kind": "template",
              "template": "animate",
              "tol": 600,
              "minRatio": 0.3,
              "frac": [
                0.1,
                0.1,
                0.9,
                0.9
              ]
            }
          ]
        },
        {
          "name": "呼吸态灰条为 SurfaceActive",
          "target": {
            "label": "skeleton",
            "index": 1
          },
          "then": [
            {
              "kind": "colorRatio",
              "frac": [
                0.3,
                0.3,
                0.4,
                0.4
              ],
              "expect": {
                "token": "SurfaceActive"
              },
              "minRatio": 0.4,
              "tol": 14
            }
          ]
        }
      ]
    },
    {
      "name": "元素形态",
      "cases": [
        {
          "name": "按钮/输入/图片骨架三形态存在",
          "target": {
            "label": "skeleton-button"
          },
          "when": [],
          "then": [
            {
              "kind": "exists",
              "target": {
                "label": "skeleton-button"
              },
              "count": 3
            },
            {
              "kind": "exists",
              "target": {
                "label": "skeleton-input"
              }
            },
            {
              "kind": "exists",
              "target": {
                "label": "skeleton-image"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "组合形态",
      "cases": [
        {
          "name": "头像圆条存在且为 32×32",
          "target": {
            "label": "skeleton-avatar"
          },
          "then": [
            {
              "kind": "exists"
            },
            {
              "kind": "geometry",
              "widthBetween": [
                30,
                34
              ],
              "heightBetween": [
                30,
                34
              ]
            }
          ]
        },
        {
          "name": "头像圆条为 SurfaceActive 灰",
          "target": {
            "label": "skeleton-avatar"
          },
          "then": [
            {
              "kind": "colorRatio",
              "frac": [
                0.3,
                0.3,
                0.4,
                0.4
              ],
              "expect": {
                "token": "SurfaceActive"
              },
              "minRatio": 0.5,
              "tol": 10
            }
          ]
        },
        {
          "name": "标题条在头像右侧",
          "target": {
            "label": "skeleton-title"
          },
          "then": [
            {
              "kind": "geometry",
              "rightOf": {
                "label": "skeleton-avatar"
              },
              "widthBetween": [
                110,
                130
              ]
            }
          ]
        }
      ]
    }
  ]
}
