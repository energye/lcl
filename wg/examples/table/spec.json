{
  "id": "table",
  "structure": {
    "sections": [
      "分页表格",
      "四列混排"
    ],
    "apiRows": 8,
    "minElements": 12
  },
  "sections": [
    {
      "name": "分页表格",
      "cases": [
        {
          "name": "分页器存在且页码 1（首页）",
          "target": {
            "label": "page",
            "text": "1"
          },
          "then": [
            {
              "kind": "exists"
            }
          ]
        },
        {
          "name": "总条数文字 23 条",
          "target": {
            "label": "page-total"
          },
          "then": [
            {
              "kind": "text",
              "text": "共 23 条"
            }
          ]
        },
        {
          "name": "第 1 页首行为 field_01",
          "target": {
            "label": "table-row",
            "text": "field_01"
          },
          "then": [
            {
              "kind": "exists"
            }
          ]
        },
        {
          "name": "点击页码 3 翻页（field_11 入窗）",
          "target": {
            "label": "page",
            "text": "3"
          },
          "when": [
            {
              "click": {}
            },
            {
              "wait": 300
            }
          ],
          "then": [
            {
              "kind": "exists",
              "target": {
                "label": "table-row",
                "text": "field_11"
              }
            }
          ]
        },
        {
          "name": "翻页后 field_01 出窗（absent）",
          "target": {
            "label": "table-row",
            "text": "field_01"
          },
          "then": [
            {
              "kind": "absent",
              "target": {
                "label": "table-row",
                "text": "field_01"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "四列混排",
      "cases": [
        {
          "name": "行悬停出现浅色底反馈",
          "target": {
            "label": "table-row",
            "index": 2
          },
          "when": [
            {
              "hover": {}
            },
            {
              "wait": 200
            }
          ],
          "then": [
            {
              "kind": "colorDelta",
              "tolPeak": 3,
              "minRatio": 0.03
            }
          ]
        },
        {
          "name": "行点击选中背景（token Selection）",
          "target": {
            "label": "table-row",
            "index": 1
          },
          "when": [],
          "then": [
            {
              "kind": "template",
              "template": "table-row-select"
            }
          ]
        },
        {
          "name": "点击字段表头首次排序为降序",
          "target": {
            "label": "table-sort",
            "index": 0
          },
          "when": [
            {
              "click": {}
            }
          ],
          "then": [
            {
              "kind": "text",
              "text": "↓",
              "target": {
                "label": "table-sort",
                "index": 0
              }
            }
          ]
        },
        {
          "name": "再次点击表头切回升序",
          "target": {
            "label": "table-sort",
            "index": 0
          },
          "when": [
            {
              "click": {}
            }
          ],
          "then": [
            {
              "kind": "text",
              "text": "↑",
              "target": {
                "label": "table-sort",
                "index": 0
              }
            }
          ]
        }
      ]
    }
  ]
}
