{
  "id": "table", 
  "sections": [
    {
      "cases": [
        {
          "name": "冻结列字段（左列）文本在冻结层可见", 
          "target": {
            "label": "table-row", 
            "text": "id"
          }, 
          "then": [
            {
              "kind": "exists"
            }
          ]
        }, 
        {
          "name": "横向滚动 300 后冻结列字段仍在视口左缘（不随滚）", 
          "target": {
            "label": "table-frozen-cell"
          }, 
          "then": [
            {
              "kind": "geometry", 
              "target": {
                "label": "table-frozen-cell"
              }, 
              "xBetween": [
                72, 
                140
              ]
            }
          ], 
          "when": [
            {
              "wheel": 300, 
              "wheelAxis": "x"
            }, 
            {
              "wait": 400
            }
          ]
        }, 
        {
          "name": "横向滚动到尽头后备注列进入视口右半（x ∈ [620,700]）", 
          "target": {
            "label": "table-row", 
            "text": "备注 id"
          }, 
          "then": [
            {
              "kind": "geometry", 
              "target": {
                "label": "table-row", 
                "text": "备注 id"
              }, 
              "xBetween": [
                620, 
                700
              ]
            }
          ]
        }
      ], 
      "name": "固定列"
    }, 
    {
      "cases": [
        {
          "name": "分页器存在且页码 1（首页）", 
          "target": {
            "label": "page", 
            "text": "1"
          }, 
          "then": [
            {
              "kind": "exists"
            }
          ]
        }, 
        {
          "name": "总条数文字 23 条", 
          "target": {
            "label": "page-total"
          }, 
          "then": [
            {
              "kind": "text", 
              "text": "共 23 条"
            }
          ]
        }, 
        {
          "name": "第 1 页首行为 field_01", 
          "target": {
            "label": "table-row", 
            "text": "field_01"
          }, 
          "then": [
            {
              "kind": "exists"
            }
          ]
        }, 
        {
          "name": "点击页码 3 翻页（field_11 入窗）", 
          "target": {
            "label": "page", 
            "text": "3"
          }, 
          "then": [
            {
              "kind": "exists", 
              "target": {
                "label": "table-row", 
                "text": "field_11"
              }
            }
          ], 
          "when": [
            {
              "click": {}
            }, 
            {
              "wait": 300
            }
          ]
        }, 
        {
          "name": "翻页后 field_01 出窗（absent）", 
          "target": {
            "label": "table-row", 
            "text": "field_01"
          }, 
          "then": [
            {
              "kind": "absent", 
              "target": {
                "label": "table-row", 
                "text": "field_01"
              }
            }
          ]
        }
      ], 
      "name": "分页表格"
    }, 
    {
      "cases": [
        {
          "name": "行悬停出现浅色底反馈", 
          "target": {
            "index": 2, 
            "label": "table-row"
          }, 
          "then": [
            {
              "kind": "colorDelta", 
              "minRatio": 0.03, 
              "tolPeak": 3
            }
          ], 
          "when": [
            {
              "hover": {}
            }, 
            {
              "wait": 200
            }
          ]
        }, 
        {
          "name": "行点击选中背景（token Selection）", 
          "target": {
            "index": 1, 
            "label": "table-row"
          }, 
          "then": [
            {
              "kind": "template", 
              "template": "table-row-select"
            }
          ], 
          "when": []
        }, 
        {
          "name": "点击字段表头首次排序为降序", 
          "target": {
            "index": 0, 
            "label": "table-sort"
          }, 
          "then": [
            {
              "kind": "text", 
              "target": {
                "index": 0, 
                "label": "table-sort"
              }, 
              "text": "↓"
            }
          ], 
          "when": [
            {
              "click": {}
            }
          ]
        }, 
        {
          "name": "再次点击表头切回升序", 
          "target": {
            "index": 0, 
            "label": "table-sort"
          }, 
          "then": [
            {
              "kind": "text", 
              "target": {
                "index": 0, 
                "label": "table-sort"
              }, 
              "text": "↑"
            }
          ], 
          "when": [
            {
              "click": {}
            }
          ]
        }
      ], 
      "name": "四列混排"
    }, 
    {
      "cases": [
        {
          "name": "状态列 Tag 渲染且绿底", 
          "target": {
            "label": "tag", 
            "text": "已上线"
          }, 
          "then": [
            {
              "kind": "exists", 
              "target": {
                "label": "tag", 
                "text": "已上线"
              }
            }, 
            {
              "expect": {
                "hex": "#E4F6DB"
              }, 
              "frac": [
                0.3, 
                0.3, 
                0.5, 
                0.5
              ], 
              "kind": "colorRatio", 
              "minRatio": 0.3, 
              "target": {
                "label": "tag", 
                "text": "已上线"
              }, 
              "tol": 20
            }, 
            {
              "kind": "exists", 
              "target": {
                "label": "tag", 
                "text": "开发中"
              }
            }
          ]
        }, 
        {
          "name": "操作列链接按钮存在", 
          "target": {
            "label": "button", 
            "text": "编辑"
          }, 
          "then": [
            {
              "count": 3, 
              "kind": "exists", 
              "target": {
                "label": "button", 
                "text": "编辑"
              }
            }
          ]
        }, 
        {
          "name": "Render 优先于 Formatter（名称列显示原值）", 
          "target": {
            "label": "table-row", 
            "text": "用户表"
          }, 
          "then": [
            {
              "kind": "text", 
              "target": {
                "label": "table-row", 
                "text": "用户表"
              }, 
              "text": "用户表"
            }, 
            {
              "kind": "text", 
              "notContains": true, 
              "target": {
                "label": "table-row", 
                "text": "用户表"
              }, 
              "text": "不应显示"
            }
          ]
        }
      ], 
      "name": "单元格渲染"
    }, 
    {
      "cases": [
        {
          "name": "初始展开首行：展开内容可见", 
          "target": {
            "label": "table-expanded-row", 
            "text": "用户服务 · 部署详情"
          }, 
          "then": [
            {
              "kind": "exists"
            }, 
            {
              "kind": "text", 
              "target": {
                "label": "table-expanded-row", 
                "text": "用户服务 · 部署详情"
              }, 
              "text": "实例 2 个"
            }
          ]
        }, 
        {
          "name": "展开行高 48（ExpandedRowHeight 默认值）", 
          "target": {
            "label": "table-expanded-row", 
            "text": "用户服务 · 部署详情"
          }, 
          "then": [
            {
              "kind": "geometry", 
              "heightBetween": [
                46, 
                52
              ]
            }
          ]
        }, 
        {
          "name": "展开行紧跟父行（below 用户服务行）", 
          "target": {
            "label": "table-expanded-row", 
            "text": "用户服务 · 部署详情"
          }, 
          "then": [
            {
              "kind": "geometry", 
              "below": {
                "label": "table-row", 
                "text": "用户服务"
              }
            }
          ]
        }, 
        {
          "name": "收起图标点击后展开行消失（caret down→切换）", 
          "target": {
            "index": 0, 
            "label": "table-expand"
          }, 
          "then": [
            {
              "kind": "absent", 
              "target": {
                "label": "table-expanded-row", 
                "text": "用户服务 · 部署详情"
              }
            }
          ], 
          "when": [
            {
              "click": {}
            }, 
            {
              "wait": 300
            }
          ]
        }, 
        {
          "name": "再次点击展开图标后内容行回来", 
          "target": {
            "index": 0, 
            "label": "table-expand"
          }, 
          "then": [
            {
              "kind": "exists", 
              "target": {
                "label": "table-expanded-row", 
                "text": "用户服务 · 部署详情"
              }
            }
          ], 
          "when": [
            {
              "click": {}
            }, 
            {
              "wait": 300
            }
          ]
        }, 
        {
          "name": "展开第二行（订单服务）内容可见", 
          "target": {
            "index": 1, 
            "label": "table-expand"
          }, 
          "then": [
            {
              "kind": "exists", 
              "target": {
                "label": "table-expanded-row", 
                "text": "订单服务 · 部署详情"
              }
            }
          ], 
          "when": [
            {
              "click": {}
            }, 
            {
              "wait": 300
            }
          ]
        }
      ], 
      "name": "展开行"
    }
  ], 
  "structure": {
    "apiRows": 9, 
    "minElements": 12, 
    "sections": [
      "固定列", 
      "分页表格", 
      "四列混排", 
      "单元格渲染", 
      "展开行"
    ]
  }
}
